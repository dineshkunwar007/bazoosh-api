# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Rate Limiting Configuration
RATE_LIMIT_MAX_PER_HOUR=10
RATE_LIMIT_MAX_PER_DAY=30

# Cache Configuration
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.85
CACHE_TTL_HOURS=168

# Budget Configuration (USD)
BUDGET_ALERT_USD=50
BUDGET_LIMIT_USD=100

# CORS Configuration
CORS_ALLOWED_ORIGINS=*

# Firebase Functions Config (alternative to environment variables)
# Use: firebase functions:config:set openai.api_key="your_key"
